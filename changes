import React, { useState, useCallback } from 'react';
import { getBrokerRestartHistory } from '../../Api/HandOverApi';
import './BrokerRestartHistory.css';

// ─── Helpers ──────────────────────────────────────────────────────────────────

const PAGE_SIZE = 10;

function formatDateTime(raw) {
  if (!raw) return '—';
  const d = new Date(raw.replace(' ', 'T'));
  if (isNaN(d)) return raw;
  const date = d.toLocaleDateString('en-GB', {
    day: '2-digit', month: 'short', year: 'numeric',
  });
  const time = d.toLocaleTimeString('en-GB', {
    hour: '2-digit', minute: '2-digit', second: '2-digit',
  });
  return { date, time };
}

// ─── Sub-components ───────────────────────────────────────────────────────────

function TimeCell({ value }) {
  if (!value) return <span style={{ color: 'var(--text-secondary)', opacity: 0.4 }}>—</span>;
  const { date, time } = formatDateTime(value);
  return (
    <div style={{ lineHeight: 1.6 }}>
      <div style={{ color: 'var(--text-secondary)', fontSize: '0.8rem' }}>{date}</div>
      <div style={{ color: 'var(--primary-blue)', fontSize: '0.85rem', fontFamily: "'Courier New', monospace", fontWeight: 600 }}>{time}</div>
    </div>
  );
}

function ServerListCell({ list }) {
  if (!list) return <span style={{ color: 'var(--text-secondary)', opacity: 0.4 }}>—</span>;
  const servers = list.trim().split(/\s+/);
  return (
    <div style={{ display: 'flex', flexWrap: 'wrap', gap: '0.3rem', maxWidth: '320px' }}>
      {servers.map((s, i) => (
        <span key={i} className="server-pill-item">{s}</span>
      ))}
    </div>
  );
}

function StatusBadge({ status }) {
  const s = (status || '').toLowerCase();
  const cls = s === 'completed' ? 'set-status set-status-completed' : 'set-status';
  const dot = s === 'completed' ? '✓' : s === 'pending' ? '○' : '•';
  return (
    <span className={cls}>
      {dot} {status || '—'}
    </span>
  );
}

// ─── Column definitions — only fields that appear in the actual API response ──

const COLUMNS = [
  {
    key: 'infraName',
    label: 'Infra / Support',
    sortable: true,
    width: '200px',
    render: (r) => (
      <div style={{ lineHeight: 1.7 }}>
        <div>
          <span className="infra-name"><strong>{r.infraName || '—'}</strong></span>
        </div>
        <div style={{ display: 'flex', alignItems: 'center', gap: '0.4rem', marginTop: '0.2rem' }}>
          <span className="subset-id" style={{ fontSize: '0.75rem' }}>{r.infraId || '—'}</span>
        </div>
      </div>
    ),
  },
  {
    key: 'supportName',
    label: 'Support Name',
    sortable: true,
    width: '200px',
    render: (r) => (
      <div style={{ lineHeight: 1.7 }}>
        <div style={{ color: 'var(--text-primary)', fontWeight: 600, fontSize: '0.9rem' }}>
          {r.supportName || '—'}
        </div>
        <div>
          <span
            className="infra-info"
            style={{ fontSize: '0.75rem', marginTop: '0.2rem', display: 'inline-block' }}
          >
            ID: {r.supportid || '—'}
          </span>
        </div>
      </div>
    ),
  },
  {
    key: 'serverSet',
    label: 'Server Set',
    sortable: true,
    width: '160px',
    render: (r) => <span className="server-set-badge">{r.serverSet || '—'}</span>,
  },
  {
    key: 'status',
    label: 'Status',
    sortable: true,
    width: '120px',
    render: (r) => <StatusBadge status={r.status} />,
  },
  {
    key: 'startTime',
    label: 'Start Time',
    sortable: true,
    width: '150px',
    render: (r) => <TimeCell value={r.startTime} />,
  },
  {
    key: 'endTime',
    label: 'End Time',
    sortable: true,
    width: '150px',
    render: (r) => <TimeCell value={r.endTime} />,
  },
  {
    key: 'supportTime',
    label: 'Support Time',
    sortable: true,
    width: '150px',
    render: (r) => <TimeCell value={r.supportTime} />,
  },
  {
    key: 'serverList',
    label: 'Server List',
    sortable: false,
    width: '340px',
    render: (r) => <ServerListCell list={r.serverList} />,
  },
];

// ─── Inline structural styles ─────────────────────────────────────────────────

const TABLE_STYLE = {
  width: '100%',
  borderCollapse: 'collapse',
  fontSize: '0.88rem',
};

const TH_BASE = {
  padding: '1rem 1.25rem',
  textAlign: 'left',
  color: 'var(--primary-blue)',
  borderBottom: '2px solid var(--border-color)',
  whiteSpace: 'nowrap',
  fontWeight: 700,
  fontSize: '0.75rem',
  textTransform: 'uppercase',
  letterSpacing: '0.7px',
  background: 'rgba(46,213,255,0.05)',
  userSelect: 'none',
};

const TD_BASE = {
  padding: '1rem 1.25rem',
  borderBottom: '1px solid rgba(255,255,255,0.045)',
  verticalAlign: 'middle',
};

// ─── Main Component ───────────────────────────────────────────────────────────

export default function BrokerRestartHistory() {
  const todayStr = new Date().toISOString().split('T')[0];

  const [inputDate, setInputDate]       = useState(todayStr);
  const [fetchedDate, setFetchedDate]   = useState('');
  const [hasFetched, setHasFetched]     = useState(false);

  const [data, setData]                 = useState([]);
  const [loading, setLoading]           = useState(false);
  const [error, setError]               = useState(null);

  const [search, setSearch]             = useState('');
  const [statusFilter, setStatusFilter] = useState('all');
  const [sortKey, setSortKey]           = useState('startTime');
  const [sortDir, setSortDir]           = useState('desc');
  const [page, setPage]                 = useState(1);

  // ── Fetch on button click only ────────────────────────────────────────────
  const handleFetch = useCallback(async () => {
    if (!inputDate) return;
    setLoading(true);
    setError(null);
    setSearch('');
    setStatusFilter('all');
    setPage(1);
    try {
      const res = await getBrokerRestartHistory(inputDate);
      setData(res?.SubsetsData || []);
      setFetchedDate(inputDate);
      setHasFetched(true);
    } catch (e) {
      setError(e.message || 'Failed to fetch handover history.');
      setData([]);
    } finally {
      setLoading(false);
    }
  }, [inputDate]);

  // ── Filter ────────────────────────────────────────────────────────────────
  const filtered = data.filter((r) => {
    const q = search.toLowerCase();
    const matchSearch =
      !q ||
      (r.infraName   || '').toLowerCase().includes(q) ||
      (r.infraId     || '').toLowerCase().includes(q) ||
      (r.supportName || '').toLowerCase().includes(q) ||
      (r.supportid   || '').toLowerCase().includes(q) ||
      (r.serverSet   || '').toLowerCase().includes(q) ||
      (r.serverList  || '').toLowerCase().includes(q);
    const matchStatus =
      statusFilter === 'all' || (r.status || '').toLowerCase() === statusFilter;
    return matchSearch && matchStatus;
  });

  // ── Sort ──────────────────────────────────────────────────────────────────
  const sorted = [...filtered].sort((a, b) => {
    let av = a[sortKey] ?? '';
    let bv = b[sortKey] ?? '';
    return sortDir === 'asc'
      ? String(av).localeCompare(String(bv))
      : String(bv).localeCompare(String(av));
  });

  // ── Paginate ──────────────────────────────────────────────────────────────
  const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
  const paginated  = sorted.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

  const handleSort = (key) => {
    if (sortKey === key) setSortDir((d) => (d === 'asc' ? 'desc' : 'asc'));
    else { setSortKey(key); setSortDir('asc'); }
    setPage(1);
  };

  const statuses = [
    'all',
    ...Array.from(new Set(data.map((r) => (r.status || '').toLowerCase()).filter(Boolean))),
  ];

  const completedCount = data.filter(
    (r) => (r.status || '').toLowerCase() === 'completed'
  ).length;

  const formattedFetchedDate = fetchedDate
    ? new Date(fetchedDate + 'T00:00:00').toLocaleDateString('en-GB', {
        weekday: 'long', day: '2-digit', month: 'long', year: 'numeric',
      })
    : '';

  // ── Render ────────────────────────────────────────────────────────────────
  return (
    <div className="tasks-list-page">

      {/* ── Page Header ──────────────────────────────────────────────────── */}
      <div className="tasks-list-header">
        <div className="header-content">
          <h1>📋 Shift Handover History</h1>
          <p>Select a date and fetch the shift handover sessions for that day</p>
        </div>

        {hasFetched && (
          <div className="header-details">
            <p>Total <strong>{data.length}</strong></p>
            <p>Completed <strong>{completedCount}</strong></p>
            <p>Filtered <strong>{filtered.length}</strong></p>
            {fetchedDate && <p>Date <strong>{formattedFetchedDate}</strong></p>}
          </div>
        )}
      </div>

      {/* ── Date Picker Section ───────────────────────────────────────────── */}
      <div className="sets-section">
        <h2>📅 Select Date</h2>

        <div style={{ display: 'flex', alignItems: 'flex-end', gap: '1.5rem', flexWrap: 'wrap' }}>

          {/* Calendar input */}
          <div className="form-group">
            <label htmlFor="handover-date">
              Date <span className="required-star">*</span>
            </label>
            <input
              id="handover-date"
              type="date"
              className="form-input"
              style={{ minWidth: '200px', cursor: 'pointer' }}
              value={inputDate}
              max={todayStr}
              onChange={(e) => setInputDate(e.target.value)}
            />
          </div>

          {/* Fetch button */}
          <button
            className="complete-btn"
            onClick={handleFetch}
            disabled={loading || !inputDate}
          >
            {loading ? '⏳ Fetching…' : '🔍 Fetch Records'}
          </button>

          {/* Refresh — visible only after first fetch */}
          {hasFetched && (
            <button
              className="btn-refresh-status"
              onClick={handleFetch}
              disabled={loading}
            >
              🔄 Refresh
            </button>
          )}
        </div>
      </div>

      {/* ── Idle prompt ───────────────────────────────────────────────────── */}
      {!hasFetched && !loading && (
        <div className="checklist-section">
          <div className="set-card click-prompt" style={{ cursor: 'default', minHeight: '200px' }}>
            <h3>📅</h3>
            <p>
              Pick a date above and click{' '}
              <strong style={{ color: 'var(--primary-blue)' }}>Fetch Records</strong>{' '}
              to load handover sessions.
            </p>
          </div>
        </div>
      )}

      {/* ── Loading ───────────────────────────────────────────────────────── */}
      {loading && (
        <div className="checklist-section">
          <div className="loading-container">
            <div className="loading-spinner" />
            <p className="loading-text">Fetching handover records…</p>
          </div>
        </div>
      )}

      {/* ── Error ─────────────────────────────────────────────────────────── */}
      {!loading && error && (
        <div className="checklist-section">
          <div className="loading-container">
            <span style={{ fontSize: '2.5rem' }}>⚠️</span>
            <p className="loading-text" style={{ color: 'var(--error-red)' }}>{error}</p>
            <button className="btn-primary" onClick={handleFetch}>Retry</button>
          </div>
        </div>
      )}

      {/* ── Results table ─────────────────────────────────────────────────── */}
      {!loading && !error && hasFetched && (
        <div className="activity-log-section" style={{ padding: 0, overflow: 'hidden' }}>

          {/* Table header + filters */}
          <div
            style={{
              padding: '1.5rem 2rem',
              borderBottom: '1px solid var(--border-color)',
              display: 'flex',
              flexWrap: 'wrap',
              justifyContent: 'space-between',
              alignItems: 'center',
              gap: '1rem',
            }}
          >
            <h2 style={{ margin: 0 }}>🗂 Handover Sessions</h2>

            <div style={{ display: 'flex', gap: '0.75rem', flexWrap: 'wrap', alignItems: 'center' }}>
              {/* Search */}
              <input
                className="form-input"
                style={{ minWidth: '210px', padding: '0.55rem 1rem' }}
                placeholder="🔍  Search by name, infra, set…"
                value={search}
                onChange={(e) => { setSearch(e.target.value); setPage(1); }}
              />

              {/* Status filter */}
              <select
                className="form-input server-set-dropdown"
                style={{ minWidth: '150px', padding: '0.55rem 2.5rem 0.55rem 1rem', cursor: 'pointer' }}
                value={statusFilter}
                onChange={(e) => { setStatusFilter(e.target.value); setPage(1); }}
              >
                {statuses.map((s) => (
                  <option key={s} value={s}>
                    {s === 'all'
                      ? 'All Statuses'
                      : s.charAt(0).toUpperCase() + s.slice(1)}
                  </option>
                ))}
              </select>
            </div>
          </div>

          {/* Empty */}
          {sorted.length === 0 && (
            <div className="loading-container">
              <span style={{ fontSize: '2.5rem' }}>🔍</span>
              <p className="loading-text">No records found for this date.</p>
            </div>
          )}

          {/* Table */}
          {sorted.length > 0 && (
            <>
              <div style={{ overflowX: 'auto' }}>
                <table style={TABLE_STYLE}>
                  <thead>
                    <tr>
                      <th style={{ ...TH_BASE, width: '48px', textAlign: 'center' }}>#</th>
                      {COLUMNS.map((col) => (
                        <th
                          key={col.key}
                          style={{
                            ...TH_BASE,
                            width: col.width || 'auto',
                            cursor: col.sortable ? 'pointer' : 'default',
                          }}
                          onClick={() => col.sortable && handleSort(col.key)}
                        >
                          {col.label}
                          {col.sortable && (
                            <span style={{ marginLeft: '0.4rem', opacity: sortKey === col.key ? 1 : 0.25 }}>
                              {sortKey === col.key
                                ? sortDir === 'asc' ? '↑' : '↓'
                                : '⇅'}
                            </span>
                          )}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {paginated.map((row, idx) => (
                      <tr
                        key={idx}
                        onMouseEnter={(e) =>
                          (e.currentTarget.style.background = 'rgba(46,213,255,0.035)')
                        }
                        onMouseLeave={(e) =>
                          (e.currentTarget.style.background = 'transparent')
                        }
                      >
                        {/* Row number */}
                        <td
                          style={{
                            ...TD_BASE,
                            textAlign: 'center',
                            color: 'var(--text-secondary)',
                            fontSize: '0.8rem',
                            fontFamily: "'Courier New', monospace",
                            opacity: 0.5,
                            width: '48px',
                          }}
                        >
                          {(page - 1) * PAGE_SIZE + idx + 1}
                        </td>

                        {COLUMNS.map((col) => (
                          <td key={col.key} style={TD_BASE}>
                            {col.render(row)}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {/* Pagination */}
              <div
                style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  padding: '1.1rem 2rem',
                  borderTop: '1px solid var(--border-color)',
                  flexWrap: 'wrap',
                  gap: '1rem',
                }}
              >
                <span className="log-message">
                  Showing{' '}
                  <strong style={{ color: 'var(--primary-blue)' }}>
                    {(page - 1) * PAGE_SIZE + 1}–
                    {Math.min(page * PAGE_SIZE, sorted.length)}
                  </strong>{' '}
                  of{' '}
                  <strong style={{ color: 'var(--primary-blue)' }}>{sorted.length}</strong>{' '}
                  records
                </span>

                <div style={{ display: 'flex', gap: '0.4rem', flexWrap: 'wrap' }}>
                  <button className="btn-secondary" style={{ padding: '0.4rem 0.85rem', fontSize: '0.85rem' }} disabled={page === 1} onClick={() => setPage(1)}>«</button>
                  <button className="btn-secondary" style={{ padding: '0.4rem 0.85rem', fontSize: '0.85rem' }} disabled={page === 1} onClick={() => setPage((p) => p - 1)}>‹ Prev</button>

                  {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                    let p;
                    if (totalPages <= 5)             p = i + 1;
                    else if (page <= 3)              p = i + 1;
                    else if (page >= totalPages - 2) p = totalPages - 4 + i;
                    else                             p = page - 2 + i;
                    return (
                      <button
                        key={p}
                        className="btn-secondary"
                        style={{
                          padding: '0.4rem 0.85rem',
                          fontSize: '0.85rem',
                          ...(page === p
                            ? {
                                background: 'rgba(46,213,255,0.15)',
                                borderColor: 'var(--primary-blue)',
                                color: 'var(--primary-blue)',
                                fontWeight: 700,
                              }
                            : {}),
                        }}
                        onClick={() => setPage(p)}
                      >
                        {p}
                      </button>
                    );
                  })}

                  <button className="btn-secondary" style={{ padding: '0.4rem 0.85rem', fontSize: '0.85rem' }} disabled={page === totalPages} onClick={() => setPage((p) => p + 1)}>Next ›</button>
                  <button className="btn-secondary" style={{ padding: '0.4rem 0.85rem', fontSize: '0.85rem' }} disabled={page === totalPages} onClick={() => setPage(totalPages)}>»</button>
                </div>
              </div>
            </>
          )}
        </div>
      )}

      {/* ── Extra CSS for server pills (only structural, scoped inline) ───── */}
      <style>{`
        .server-pill-item {
          display: inline-block;
          padding: 0.18rem 0.5rem;
          border-radius: 4px;
          background: rgba(138, 43, 226, 0.12);
          color: #b388ff;
          border: 1px solid rgba(138, 43, 226, 0.28);
          font-family: 'Courier New', monospace;
          font-size: 0.75rem;
          font-weight: 600;
          line-height: 1.4;
        }
      `}</style>

    </div>
  );
}
