import React, { useState, useCallback } from 'react';
import { getHistoryHandovers } from './handoverHistoryApi';
import './TasksList.css';

// ─── Helpers ─────────────────────────────────────────────────────────────────

const PAGE_SIZE = 10;

function formatDateTime(raw) {
  if (!raw) return '—';
  const d = new Date(raw.replace(' ', 'T'));
  if (isNaN(d)) return raw;
  const date = d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  const time = d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  return `${date}, ${time}`;
}

function getStatusClass(status) {
  const s = (status || '').toLowerCase();
  if (s === 'completed') return 'set-status set-status-completed';
  return 'set-status';
}

// ─── Table columns definition ─────────────────────────────────────────────────

const COLUMNS = [
  { key: 'id',              label: '#',              sortable: true  },
  { key: 'status',          label: 'Status',         sortable: true  },
  { key: 'infraName',       label: 'Infra Name',     sortable: true  },
  { key: 'infraId',         label: 'Infra ID',       sortable: true  },
  { key: 'supportName',     label: 'Support Name',   sortable: true  },
  { key: 'supportId',       label: 'Support ID',     sortable: true  },
  { key: 'serverSet',       label: 'Server Set',     sortable: true  },
  { key: 'serverList',      label: 'Servers',        sortable: false },
  { key: 'brokerRestartId', label: 'Broker Restart', sortable: true  },
  { key: 'startTime',       label: 'Start Time',     sortable: true  },
  { key: 'endTime',         label: 'End Time',       sortable: true  },
  { key: 'supportTime',     label: 'Support Time',   sortable: true  },
];

// ─── Inline layout styles (structural only — theme comes from TasksList.css) ──

const TABLE_STYLE = { width: '100%', borderCollapse: 'collapse', fontSize: '0.88rem' };

const TH_STYLE = {
  padding: '0.9rem 1.1rem',
  textAlign: 'left',
  color: 'var(--primary-blue)',
  borderBottom: '2px solid var(--border-color)',
  whiteSpace: 'nowrap',
  fontWeight: 700,
  fontSize: '0.78rem',
  textTransform: 'uppercase',
  letterSpacing: '0.6px',
  background: 'rgba(46,213,255,0.04)',
  userSelect: 'none',
};

const TD_STYLE = {
  padding: '0.9rem 1.1rem',
  borderBottom: '1px solid rgba(255,255,255,0.04)',
  verticalAlign: 'middle',
};

// ─── Main Component ───────────────────────────────────────────────────────────

export default function HandoverHistoryPage() {
  const todayStr = new Date().toISOString().split('T')[0]; // YYYY-MM-DD

  // ── State ──────────────────────────────────────────────────────────────────
  const [inputDate, setInputDate]       = useState(todayStr);   // calendar value (not yet fetched)
  const [fetchedDate, setFetchedDate]   = useState('');          // date that was actually fetched
  const [hasFetched, setHasFetched]     = useState(false);       // whether any fetch has been done

  const [data, setData]                 = useState([]);
  const [loading, setLoading]           = useState(false);
  const [error, setError]               = useState(null);

  const [search, setSearch]             = useState('');
  const [statusFilter, setStatusFilter] = useState('all');
  const [sortKey, setSortKey]           = useState('id');
  const [sortDir, setSortDir]           = useState('desc');
  const [page, setPage]                 = useState(1);

  // ── Fetch handler (called only on button click) ────────────────────────────
  const handleFetch = useCallback(async () => {
    if (!inputDate) return;
    setLoading(true);
    setError(null);
    setSearch('');
    setStatusFilter('all');
    setPage(1);
    try {
      const res = await getHistoryHandovers(inputDate);
      setData(res?.SubsetsData || []);
      setFetchedDate(inputDate);
      setHasFetched(true);
    } catch (e) {
      setError(e.message || 'Failed to fetch handover history.');
      setData([]);
    } finally {
      setLoading(false);
    }
  }, [inputDate]);

  // ── Filter ────────────────────────────────────────────────────────────────
  const filtered = data.filter((r) => {
    const q = search.toLowerCase();
    const matchSearch =
      !q ||
      String(r.id).includes(q) ||
      (r.infraName   || '').toLowerCase().includes(q) ||
      (r.infraId     || '').toLowerCase().includes(q) ||
      (r.supportName || '').toLowerCase().includes(q) ||
      (r.supportId   || '').toLowerCase().includes(q) ||
      (r.serverSet   || '').toLowerCase().includes(q) ||
      (r.serverList  || '').toLowerCase().includes(q);
    const matchStatus =
      statusFilter === 'all' || (r.status || '').toLowerCase() === statusFilter;
    return matchSearch && matchStatus;
  });

  // ── Sort ──────────────────────────────────────────────────────────────────
  const sorted = [...filtered].sort((a, b) => {
    let av = a[sortKey] ?? '';
    let bv = b[sortKey] ?? '';
    if (typeof av === 'number') return sortDir === 'asc' ? av - bv : bv - av;
    return sortDir === 'asc'
      ? String(av).localeCompare(String(bv))
      : String(bv).localeCompare(String(av));
  });

  // ── Paginate ──────────────────────────────────────────────────────────────
  const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
  const paginated  = sorted.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

  const handleSort = (key) => {
    if (sortKey === key) setSortDir((d) => (d === 'asc' ? 'desc' : 'asc'));
    else { setSortKey(key); setSortDir('asc'); }
    setPage(1);
  };

  const statuses = [
    'all',
    ...Array.from(new Set(data.map((r) => (r.status || '').toLowerCase()).filter(Boolean))),
  ];

  const completedCount = data.filter(
    (r) => (r.status || '').toLowerCase() === 'completed'
  ).length;

  // ── Cell renderer ─────────────────────────────────────────────────────────
  const renderCell = (row, key) => {
    switch (key) {
      case 'id':
        return <span className="subset-id">#{row.id}</span>;

      case 'status':
        return (
          <span className={getStatusClass(row.status)}>
            {row.status || '—'}
          </span>
        );

      case 'infraName':
        return (
          <span className="infra-name">
            <strong>{row.infraName || '—'}</strong>
          </span>
        );

      case 'infraId':
        return <span className="subset-id">{row.infraId || '—'}</span>;

      case 'supportName':
        return (
          <span className="infra-name">
            <strong>{row.supportName || '—'}</strong>
          </span>
        );

      case 'supportId':
        return <span className="subset-id">{row.supportId || '—'}</span>;

      case 'serverSet':
        return <span className="server-set-badge">{row.serverSet || '—'}</span>;

      case 'serverList':
        if (!row.serverList)
          return <span style={{ color: 'var(--text-secondary)' }}>—</span>;
        return (
          <div className="server-numbers-compact">{row.serverList}</div>
        );

      case 'brokerRestartId':
        return <span className="subset-id">{row.brokerRestartId ?? '—'}</span>;

      case 'startTime':
      case 'endTime':
      case 'supportTime':
        return (
          <span
            style={{
              fontSize: '0.85rem',
              color: 'var(--text-secondary)',
              fontFamily: "'Courier New', monospace",
            }}
          >
            {row[key] ? formatDateTime(row[key]) : '—'}
          </span>
        );

      default:
        return <span>{row[key] ?? '—'}</span>;
    }
  };

  // ── Render ────────────────────────────────────────────────────────────────
  return (
    <div className="tasks-list-page">

      {/* ── Page Header ────────────────────────────────────────────────────── */}
      <div className="tasks-list-header">
        <div className="header-content">
          <h1>📋 Shift Handover History</h1>
          <p>Select a date and fetch the shift handover sessions for that day</p>
        </div>

        {hasFetched && (
          <div className="header-details">
            <p>Total Records <strong>{data.length}</strong></p>
            <p>Completed <strong>{completedCount}</strong></p>
            <p>Filtered <strong>{filtered.length}</strong></p>
            {fetchedDate && (
              <p>
                Showing data for{' '}
                <strong>
                  {new Date(fetchedDate + 'T00:00:00').toLocaleDateString('en-GB', {
                    day: '2-digit', month: 'short', year: 'numeric',
                  })}
                </strong>
              </p>
            )}
          </div>
        )}
      </div>

      {/* ── Date Picker Card ────────────────────────────────────────────────── */}
      <div className="sets-section">
        <h2>📅 Select Date</h2>

        <div
          style={{
            display: 'flex',
            alignItems: 'flex-end',
            gap: '1.5rem',
            flexWrap: 'wrap',
          }}
        >
          {/* Date input */}
          <div className="form-group" style={{ flex: '0 0 auto' }}>
            <label htmlFor="handover-date">
              Date <span className="required-star">*</span>
            </label>
            <input
              id="handover-date"
              type="date"
              className="form-input"
              style={{ minWidth: '200px', padding: '0.85rem 1rem', cursor: 'pointer' }}
              value={inputDate}
              max={todayStr}
              onChange={(e) => setInputDate(e.target.value)}
            />
          </div>

          {/* Selected date preview */}
          {inputDate && (
            <div className="readonly-info-box" style={{ flex: '0 0 auto' }}>
              <span>
                {new Date(inputDate + 'T00:00:00').toLocaleDateString('en-GB', {
                  weekday: 'long', day: '2-digit', month: 'long', year: 'numeric',
                })}
              </span>
              {fetchedDate === inputDate && (
                <span className="readonly-badge">✓ Fetched</span>
              )}
            </div>
          )}

          {/* Fetch button */}
          <button
            className="complete-btn"
            style={{ flex: '0 0 auto' }}
            onClick={handleFetch}
            disabled={loading || !inputDate}
          >
            {loading ? '⏳ Fetching…' : '🔍 Fetch Records'}
          </button>

          {/* Refresh button — only shown after first fetch */}
          {hasFetched && (
            <button
              className="btn-refresh-status"
              style={{ flex: '0 0 auto' }}
              onClick={handleFetch}
              disabled={loading}
            >
              🔄 Refresh
            </button>
          )}
        </div>
      </div>

      {/* ── Idle state (nothing fetched yet) ────────────────────────────────── */}
      {!hasFetched && !loading && (
        <div className="checklist-section">
          <div
            className="set-card click-prompt"
            style={{ cursor: 'default', minHeight: '220px' }}
          >
            <h3>📅</h3>
            <p>Pick a date above and click <strong style={{ color: 'var(--primary-blue)' }}>Fetch Records</strong> to load handover sessions.</p>
          </div>
        </div>
      )}

      {/* ── Loading state ───────────────────────────────────────────────────── */}
      {loading && (
        <div className="checklist-section">
          <div className="loading-container">
            <div className="loading-spinner" />
            <p className="loading-text">Fetching handover records…</p>
          </div>
        </div>
      )}

      {/* ── Error state ─────────────────────────────────────────────────────── */}
      {!loading && error && (
        <div className="checklist-section">
          <div className="loading-container">
            <span style={{ fontSize: '2.5rem' }}>⚠️</span>
            <p className="loading-text" style={{ color: 'var(--error-red)' }}>{error}</p>
            <button className="btn-primary" onClick={handleFetch}>Retry</button>
          </div>
        </div>
      )}

      {/* ── Results ─────────────────────────────────────────────────────────── */}
      {!loading && !error && hasFetched && (

        <div className="activity-log-section" style={{ padding: 0, overflow: 'hidden' }}>

          {/* Section heading + filters row */}
          <div
            style={{
              padding: '1.75rem 2rem 1.25rem',
              borderBottom: '1px solid var(--border-color)',
              display: 'flex',
              flexWrap: 'wrap',
              justifyContent: 'space-between',
              alignItems: 'center',
              gap: '1rem',
            }}
          >
            <h2 style={{ margin: 0 }}>🗂 Handover Sessions</h2>

            <div
              className="user-info-content"
              style={{ gap: '0.75rem', flexWrap: 'wrap' }}
            >
              {/* Search */}
              <input
                className="form-input"
                style={{ minWidth: '200px', padding: '0.55rem 1rem' }}
                placeholder="🔍  Search records…"
                value={search}
                onChange={(e) => { setSearch(e.target.value); setPage(1); }}
              />

              {/* Status filter */}
              <select
                className="form-input server-set-dropdown"
                style={{ minWidth: '150px', padding: '0.55rem 2.5rem 0.55rem 1rem', cursor: 'pointer' }}
                value={statusFilter}
                onChange={(e) => { setStatusFilter(e.target.value); setPage(1); }}
              >
                {statuses.map((s) => (
                  <option key={s} value={s}>
                    {s === 'all'
                      ? 'All Statuses'
                      : s.charAt(0).toUpperCase() + s.slice(1)}
                  </option>
                ))}
              </select>
            </div>
          </div>

          {/* Empty results */}
          {sorted.length === 0 && (
            <div className="loading-container">
              <span style={{ fontSize: '2.5rem' }}>🔍</span>
              <p className="loading-text">No records found for this date.</p>
            </div>
          )}

          {/* Table */}
          {sorted.length > 0 && (
            <div style={{ overflowX: 'auto' }}>
              <table style={TABLE_STYLE}>
                <thead>
                  <tr>
                    {COLUMNS.map((col) => (
                      <th
                        key={col.key}
                        style={{ ...TH_STYLE, cursor: col.sortable ? 'pointer' : 'default' }}
                        onClick={() => col.sortable && handleSort(col.key)}
                      >
                        {col.label}
                        {col.sortable && (
                          <span style={{ marginLeft: '0.4rem', opacity: sortKey === col.key ? 1 : 0.3 }}>
                            {sortKey === col.key
                              ? sortDir === 'asc' ? '↑' : '↓'
                              : '⇅'}
                          </span>
                        )}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {paginated.map((row) => (
                    <tr
                      key={row.id}
                      onMouseEnter={(e) =>
                        (e.currentTarget.style.background = 'rgba(46,213,255,0.04)')
                      }
                      onMouseLeave={(e) =>
                        (e.currentTarget.style.background = 'transparent')
                      }
                    >
                      {COLUMNS.map((col) => (
                        <td key={col.key} style={TD_STYLE}>
                          {renderCell(row, col.key)}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {/* Pagination */}
          {sorted.length > 0 && (
            <div
              className="set-progress-info"
              style={{
                display: 'flex',
                justifyContent: 'space-between',
                alignItems: 'center',
                padding: '1.25rem 2rem',
                borderTop: '1px solid var(--border-color)',
                flexWrap: 'wrap',
                gap: '1rem',
              }}
            >
              <span className="log-message">
                Showing{' '}
                <strong style={{ color: 'var(--primary-blue)' }}>
                  {(page - 1) * PAGE_SIZE + 1}–
                  {Math.min(page * PAGE_SIZE, sorted.length)}
                </strong>{' '}
                of{' '}
                <strong style={{ color: 'var(--primary-blue)' }}>
                  {sorted.length}
                </strong>{' '}
                records
              </span>

              <div style={{ display: 'flex', gap: '0.5rem', flexWrap: 'wrap' }}>
                <button
                  className="btn-secondary"
                  style={{ padding: '0.45rem 0.9rem', fontSize: '0.875rem' }}
                  disabled={page === 1}
                  onClick={() => setPage(1)}
                >«</button>

                <button
                  className="btn-secondary"
                  style={{ padding: '0.45rem 0.9rem', fontSize: '0.875rem' }}
                  disabled={page === 1}
                  onClick={() => setPage((p) => p - 1)}
                >‹</button>

                {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                  let p;
                  if (totalPages <= 5)             p = i + 1;
                  else if (page <= 3)              p = i + 1;
                  else if (page >= totalPages - 2) p = totalPages - 4 + i;
                  else                             p = page - 2 + i;
                  return (
                    <button
                      key={p}
                      className="btn-secondary"
                      style={{
                        padding: '0.45rem 0.9rem',
                        fontSize: '0.875rem',
                        ...(page === p
                          ? {
                              background: 'rgba(46,213,255,0.15)',
                              borderColor: 'var(--primary-blue)',
                              color: 'var(--primary-blue)',
                              fontWeight: 700,
                            }
                          : {}),
                      }}
                      onClick={() => setPage(p)}
                    >
                      {p}
                    </button>
                  );
                })}

                <button
                  className="btn-secondary"
                  style={{ padding: '0.45rem 0.9rem', fontSize: '0.875rem' }}
                  disabled={page === totalPages}
                  onClick={() => setPage((p) => p + 1)}
                >›</button>

                <button
                  className="btn-secondary"
                  style={{ padding: '0.45rem 0.9rem', fontSize: '0.875rem' }}
                  disabled={page === totalPages}
                  onClick={() => setPage(totalPages)}
                >»</button>
              </div>
            </div>
          )}

        </div>
      )}

    </div>
  );
}
